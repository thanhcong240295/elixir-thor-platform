# Elixir Thor Platform - Environment Configuration Template
# Copy this file to .env and update values for your environment

# Application
PORT=4000
MIX_ENV=dev
PHX_HOST=localhost
SECRET_KEY_BASE=

# Database - Credentials (for dev/test, parsed from DATABASE_URL in prod)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ai_api_dev
DB_NAME_TEST=ai_api_test

# Database - Read Replica
DB_HOST_READ=127.0.0.1
DB_PORT_READ=5433

# Database - Pool Sizes
POOL_SIZE=10
POOL_SIZE_READ=10

# Production Database URL (overrides individual DB_* vars)
DATABASE_URL=
DATABASE_READ_URL=

# Production-only backend field encryption key
# Generate with: openssl rand -base64 32
DB_ENCRYPTION_KEY=

# Redis - Primary
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379
REDIS_URL_TEST=redis://127.0.0.1:6379/1

# Redis - Read Replica
REDIS_READ_URL=redis://127.0.0.1:6380/0
REDIS_PORT_READ=6380
REDIS_READ_URL_TEST=redis://127.0.0.1:6380/1

# DNS Cluster (optional for distributed deployments)
DNS_CLUSTER_QUERY=

# LiveDashboard BasicAuth (optional in dev)
# If you set one of these, set both.
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASS=

# pgAdmin UI (http://localhost:5050)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# RedisInsight UI (http://localhost:5540)
REDIS_UI_PORT=5540

# Nginx reverse proxy (http://api.localhost)
NGINX_PORT=80

# Frontend
VITE_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
